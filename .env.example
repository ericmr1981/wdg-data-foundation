# WDG Data Foundation - 本地开发环境变量示例
# 用法：
#   cp .env.example .env
#   # 然后在当前 shell 导出：
#   set -a && source .env && set +a
#
# 注意：目前 Python 脚本主要通过 DB_* 读取连接信息。

# =====================
# PostgreSQL 连接配置
# =====================
# 注意：docker-compose.yml 已将 PG 端口绑定到 127.0.0.1，避免暴露公网。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataplatform
DB_USER=postgres
DB_PASSWORD=postgres

# =====================
# Service Ports（本地）
# =====================
# Metabase
METABASE_PORT=8082
# UI（如启用）
UI_PORT=3002

# =====================
# 原始数据目录（相对项目根目录）
# =====================
# 约定默认值：inputs/
RAW_INPUT_DIR=inputs

# =====================
# brand/store mapping 放置约定
# =====================
# 约定把可配置的映射文件放到：
#   brand-docs/<brand_code>/mappings/
# 例如：
#   brand-docs/bonjur/mappings/store_name_mapping.yaml
# 详情见：docs/CONFIG_CONVENTION.md

# ──────────────────────────────────────────────────────────
# Metabase store-sync API
# 用途：POST /api/admin/metabase/sync-store-dropdown
#      (UI: /admin/stores → "同步门店下拉" 按钮)
#
# 在 Docker / VPS 上，配置 docker-compose.yml 的 ui 服务环境变量：
#   METABASE_URL:         Docker 内部 http://metabase:3000
#   METABASE_API_KEY:     与 seeding 脚本使用相同的 key
#   # 推荐：一个品牌可配置多个看板（逗号分隔）
#   METABASE_DASHBOARDS_YUFENG:      "9"
#   METABASE_DASHBOARDS_BONJUR:      "4,5"
#   METABASE_DASHBOARDS_GELATOMIIIX: "8"
#
#   # 兼容：仅同步单个看板
#   # METABASE_DASHBOARD_YUFENG:      9
# ──────────────────────────────────────────────────────────

# =====================
# Agent Service (Anthropic)
# =====================
# Anthropic API key for the WDG agent service.
# 在 https://console.anthropic.com/ 获取，agent 服务以该 key 调 Claude。
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Agent 调用的模型 ID（默认 claude-opus-4-8）。
ANTHROPIC_MODEL=claude-opus-4-8

# 浏览器 → Agent 的 WebSocket URL（Next.js 客户端读取，public 变量）。
# docker compose 网络内为 ws://agent:4101/ws；本地裸跑可改为 ws://localhost:4101/ws。
NEXT_PUBLIC_AGENT_WS_URL=ws://agent:4102/ws

# Agent 灰度比例（0 = 全部走旧路径，100 = 全部启用）。
# 通过 /admin/config/agent-frontend 运行时可调。
NEXT_PUBLIC_AGENT_ROLLOUT_PERCENT=10

# =====================
# DailyCheck MCP (蜜可诗物料看板)
# =====================
# 部署时由运维填入真实 token
DAILYCHECK_URL=http://localhost:5100
DAILYCHECK_MCP_TOKEN=
DAILYCHECK_TIMEOUT_MS=8000
