# WDG Data Foundation - 本地/VPS 环境变量示例
# 用法：
#   cp .env.example .env
#   # 然后在当前 shell 导出：
#   set -a && source .env && set +a
#
# 注意：目前 Python 脚本主要通过 DB_* 读取连接信息。

# =====================
# PostgreSQL 连接配置
# =====================
# 注意：docker-compose.dashboard.yml 已将 PG 端口绑定到 127.0.0.1，避免暴露公网。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataplatform
DB_USER=postgres
DB_PASSWORD=postgres

# =====================
# Service Ports（VPS 建议）
# =====================
# Metabase 默认改为 8081（避免与其他服务冲突）
METABASE_PORT=8081
# UI（如启用）
UI_PORT=3002

# =====================
# 原始数据目录（相对项目根目录）
# =====================
# 约定默认值：inputs/
RAW_INPUT_DIR=inputs

# =====================
# brand/store mapping 放置约定
# =====================
# 约定把可配置的映射文件放到：
#   brand-docs/<brand_code>/mappings/
# 例如：
#   brand-docs/bonjur/mappings/store_name_mapping.yaml
# 详情见：docs/CONFIG_CONVENTION.md

# ──────────────────────────────────────────────────────────
# Metabase store-sync API
# 用途：POST /api/admin/metabase/sync-store-dropdown
#      (UI: /admin/stores → "同步门店下拉" 按钮)
#
# 在 Docker / VPS 上，配置 docker-compose.yml 的 ui 服务环境变量：
#   METABASE_URL:         Docker 内部 http://metabase:3000
#   METABASE_API_KEY:     与 seeding 脚本使用相同的 key
#   # 推荐：一个品牌可配置多个看板（逗号分隔）
#   METABASE_DASHBOARDS_YUFENG:      "9"
#   METABASE_DASHBOARDS_BONJUR:      "4,5"
#   METABASE_DASHBOARDS_GELATOMIIIX: "8"
#
#   # 兼容：仅同步单个看板
#   # METABASE_DASHBOARD_YUFENG:      9
# ──────────────────────────────────────────────────────────
