# WDG Data Foundation - 本地开发环境变量示例
# 用法：
#   cp .env.example .env
#   # 然后在当前 shell 导出：
#   set -a && source .env && set +a
#
# 注意：目前 Python 脚本主要通过 DB_* 读取连接信息。

# =====================
# PostgreSQL 连接配置
# =====================
# 注意：docker-compose.yml 已将 PG 端口绑定到 127.0.0.1，避免暴露公网。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataplatform
DB_USER=postgres
DB_PASSWORD=postgres

# =====================
# Service Ports（本地）
# =====================
# Metabase
METABASE_PORT=8082
# UI（如启用）
UI_PORT=3002

# =====================
# 原始数据目录（相对项目根目录）
# =====================
# 约定默认值：inputs/
RAW_INPUT_DIR=inputs

# =====================
# brand/store mapping 放置约定
# =====================
# 约定把可配置的映射文件放到：
#   brand-docs/<brand_code>/mappings/
# 例如：
#   brand-docs/bonjur/mappings/store_name_mapping.yaml
# 详情见：docs/CONFIG_CONVENTION.md
