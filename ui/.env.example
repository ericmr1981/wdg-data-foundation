# UI (Next.js) local env example
# Copy to .env.local and fill in real values. .env.local is git-ignored.

# =====================
# PostgreSQL 连接配置
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataplatform
DB_USER=postgres
DB_PASSWORD=postgres

# =====================
# Anthropic API key for /api/chat
# =====================
# Set to your Anthropic API key (sk-ant-...). When missing, /api/chat
# returns "AI service not configured" to the user.
ANTHROPIC_API_KEY=

# Optional: override the API base URL to use a third-party Anthropic-compatible
# proxy or gateway (e.g. OpenRouter-Anthropic, internal LLM gateway).
# Leave blank to use the official Anthropic API at https://api.anthropic.com.
# ANTHROPIC_BASE_URL=https://your-anthropic-compatible-proxy.example.com

# Optional: override the model name. Default is claude-opus-4-8 (the model the
# chat adapter is tuned for). Change to whatever your proxy supports
# (e.g. claude-sonnet-4-6, claude-3-5-sonnet-20241022, etc.).
# ANTHROPIC_MODEL=claude-opus-4-8

# =====================
# Agent credential encryption key (for DB-stored API keys)
# =====================
# Required if you use /u/admin/agent-config to store the API key in
# ops.chat_agent_credentials. The admin UI encrypts the key with
# AES-256-GCM using this env var (SHA-256-derived 32-byte key) before
# writing to the DB. Decrypts on every /api/chat request.
#
# Minimum 16 chars. RECOMMENDED: a long random string, e.g.
#   openssl rand -hex 32
#
# IMPORTANT: keep this value the SAME across all server instances
# (if you run multiple). If you change it, previously-encrypted keys
# in the DB become unreadable.
#
# If unset, the admin UI will refuse to save credentials (the chat
# will still work using ANTHROPIC_API_KEY env var as fallback).
# AGENT_CRED_ENCRYPTION_KEY=replace-with-32-byte-random-string-from-openssl

# =====================
# Agent Service (v1 chat transport)
# =====================
# When NEXT_PUBLIC_AGENT_ROLLOUT_PERCENT > 0, a deterministic hash of the
# user's id is used to route a percentage of chat sends to the new Agent
# Service (WebSocket transport) instead of the legacy /api/chat (SSE).
# v0 (/api/chat) is the default. Set to 100 for full cutover once the
# Agent Service is battle-tested.
NEXT_PUBLIC_AGENT_WS_URL=ws://agent:4101/ws
NEXT_PUBLIC_AGENT_ROLLOUT_PERCENT=0

# =====================
# DailyCheck MCP (蜜可诗物料看板)
# =====================
# 部署时由运维填入真实 token
DAILYCHECK_URL=http://localhost:5100
DAILYCHECK_MCP_TOKEN=
DAILYCHECK_TIMEOUT_MS=8000
