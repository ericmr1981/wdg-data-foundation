# UI (Next.js) local env example
# Copy to .env.local and fill in real values. .env.local is git-ignored.

# =====================
# PostgreSQL 连接配置
# =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataplatform
DB_USER=postgres
DB_PASSWORD=postgres

# =====================
# Anthropic API key for /api/chat
# =====================
# Set to your Anthropic API key (sk-ant-...). When missing, /api/chat
# returns "AI service not configured" to the user.
ANTHROPIC_API_KEY=
