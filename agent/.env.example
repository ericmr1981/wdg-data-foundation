WS_PORT=4101
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@db:5432/wdg
MCP_ENDPOINT=http://ui:4100/api/mcp
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-8

CRON_TIMEZONE=Asia/Shanghai
CRON_WEEKLY_REVIEW=0 9 * * 1
CRON_MONTHLY_SUMMARY=0 10 1 * *

TASK_WORKER_COUNT=4
LOG_LEVEL=info

# 阶段 3 新增 (RS256 + JWKS;替换老 AGENT_JWT_SECRET / SUPABASE_JWT_SECRET)
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# 协议版本(本 build 默认 1) — 设不同值时握手会被 close(4000)以便强制切断老客户端
AGENT_PROTOCOL_VERSION=1
