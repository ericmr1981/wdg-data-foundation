[Unit]
Description=WDG auto-deploy: pull latest main + rebuild agent + restart services
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/wdg
# IdentitiesOnly=yes prevents ssh from trying the wrong key in the
# agent (product-m's github_account_ed25519 is bound to github.com
# in /root/.ssh/config and would otherwise be offered first).
Environment="GIT_SSH_COMMAND=ssh -i /root/.ssh/github_deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
ExecStart=/opt/wdg/deploy/systemd/wdg-deploy.sh
StandardOutput=journal
StandardError=journal
